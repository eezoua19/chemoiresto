# --------------------------------------------------------------------------
# Base de donnees MySQL / MariaDB
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# XAMPP / Laragon par defaut : utilisateur "root" sans mot de passe
# --------------------------------------------------------------------------
DATABASE_URL="mysql://root:@127.0.0.1:3306/qr_menu"

# --------------------------------------------------------------------------
# Serveur
# --------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# URL publique du frontend (utilisee pour le CORS et les QR Codes)
FRONTEND_URL="http://localhost:5173"

# URL publique de l'API (utilisee pour construire les liens d'images)
API_URL="http://localhost:4000"

# --------------------------------------------------------------------------
# Securite
# Generer une valeur aleatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# --------------------------------------------------------------------------
JWT_SECRET="changez-moi-par-une-chaine-aleatoire-tres-longue"
JWT_EXPIRES_IN="12h"

# --------------------------------------------------------------------------
# Uploads
# --------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# --------------------------------------------------------------------------
# Comptes crees par le seed de developpement
# --------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@chemoiresto.ci"
SEED_ADMIN_PASSWORD="Admin@2026"
SEED_SERVER_EMAIL="marie@chemoiresto.ci"
SEED_SERVER_PASSWORD="Serveuse@2026"
