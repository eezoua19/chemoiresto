// ---------------------------------------------------------------------------
// Schema Prisma - Menu digital par QR Code
// Base de donnees : MySQL / MariaDB
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------- ENUMS -------------------------------------

enum Role {
  ADMIN
  SERVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

// Une commande est passee depuis une table (le cas d'origine) ou emportee.
// Une commande a emporter n'a pas de table : elle est rattachee au restaurant
// seul et identifiee par un code de retrait annonce au comptoir.
enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OptionType {
  SINGLE
  MULTIPLE
}

enum ServiceRequestType {
  CALL_SERVER
  BILL
}

enum ServiceRequestStatus {
  PENDING
  TAKEN
  COMPLETED
  REQUESTED
  PROCESSING
  PAID
  CANCELLED
}

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS
  CALL_SERVER
  BILL_REQUEST
  SYSTEM
}

// Formule d'abonnement. La duree sert a pre-remplir la date d'expiration ;
// la date reste modifiable a la main, c'est elle qui fait foi.
enum SubscriptionPlan {
  HEBDOMADAIRE
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

// Etat decide par l'administrateur. L'expiration n'en fait PAS partie : elle se
// deduit de la date du jour, sinon il faudrait une tache qui passe chaque nuit
// et un abonnement resterait "valide" tant qu'elle n'a pas tourne.
enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionUsageType {
  REPAS
  BOISSON
  AUTRE
}

enum LoyaltyTransactionType {
  EARN
  REWARD_GRANTED
  REWARD_REDEEMED
  ADJUST
}

// ----------------------------- RESTAURANT ----------------------------------

model Restaurant {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  logo           String?
  description    String?  @db.Text
  address        String?
  phone          String?
  email          String?
  currency       String   @default("FCFA")
  openingHours   String?  @db.Text
  primaryColor   String   @default("#E4572E")
  welcomeMessage String?  @db.Text
  isActive       Boolean  @default(true)

  // Vente a emporter : desactivee tant que le restaurant ne l'ouvre pas.
  // Le jeton est celui de l'affiche posee au comptoir, l'equivalent du jeton
  // d'une table mais pour un client qui n'en occupe aucune.
  takeawayEnabled Boolean @default(false)
  takeawayToken   String? @unique

  // Programme de fidelite. Desactive par defaut : un restaurant qui ne
  // collecte pas de telephone client n'a de toute facon aucun compte a
  // rattacher aux commandes.
  loyaltyEnabled         Boolean @default(false)
  loyaltyRewardThreshold Int     @default(10)
  loyaltyRewardLabel     String? @db.VarChar(120)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  categories      Category[]
  products        Product[]
  tables          RestaurantTable[]
  dailyMenus      DailyMenu[]
  orders          Order[]
  customers       Customer[]
  notifications   Notification[]
  serviceRequests ServiceRequest[]
  subscriptions   Subscription[]
  subscriptionUsages SubscriptionUsage[]
  auditLogs       AuditLog[]
  snapshots       BackupSnapshot[]
  closings        DailyClosing[]
  loyaltyAccounts     LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]
  reviews             Review[]
  pushSubscriptions   PushSubscription[]
}

// -------------------------------- USER -------------------------------------

model User {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  password     String
  role         Role       @default(SERVER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders          Order[]              @relation("OrderServer")
  statusHistory   OrderStatusHistory[]
  serviceRequests ServiceRequest[]     @relation("ServiceRequestHandler")
  notifications   Notification[]
  subscriptionsCreated Subscription[]      @relation("SubscriptionAuthor")
  subscriptionUsages   SubscriptionUsage[] @relation("SubscriptionUsageAuthor")
  auditLogs            AuditLog[]          @relation("AuditAuthor")
  loyaltyTransactions  LoyaltyTransaction[] @relation("LoyaltyTransactionAuthor")
  pushSubscriptions    PushSubscription[]

  @@index([restaurantId])
}

// ------------------------------ CATEGORY -----------------------------------

model Category {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  name         String
  slug         String
  icon         String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
}

// ------------------------------- PRODUCT -----------------------------------

model Product {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  categoryId   Int?
  name         String
  description  String?  @db.Text
  basePrice    Decimal  @db.Decimal(12, 2)
  image        String?
  isAvailable  Boolean  @default(true)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options        ProductOption[]
  dailyMenuItems DailyMenuItem[]
  orderItems     OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model ProductOption {
  id         Int        @id @default(autoincrement())
  productId  Int
  name       String
  type       OptionType @default(SINGLE)
  isRequired Boolean    @default(false)
  sortOrder  Int        @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id          Int     @id @default(autoincrement())
  optionId    Int
  name        String
  priceDelta  Decimal @default(0) @db.Decimal(12, 2)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  option           ProductOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([optionId])
}

// -------------------------------- TABLE ------------------------------------

model RestaurantTable {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  number       String
  label        String?
  capacity     Int         @default(4)
  token        String      @unique
  status       TableStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCode          QRCode?
  orders          Order[]
  serviceRequests ServiceRequest[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
}

model QRCode {
  id        Int      @id @default(autoincrement())
  tableId   Int      @unique
  url       String   @db.Text
  dataUrl   String   @db.LongText
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

// ------------------------------ DAILY MENU ---------------------------------

model DailyMenu {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  date         DateTime @db.Date
  title        String?
  note         String?  @db.Text
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      DailyMenuItem[]

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

model DailyMenuItem {
  id          Int      @id @default(autoincrement())
  dailyMenuId Int
  productId   Int
  price       Decimal? @db.Decimal(12, 2)
  description String?  @db.Text
  isAvailable Boolean  @default(true)
  isDishOfDay Boolean  @default(false)
  sortOrder   Int      @default(0)

  dailyMenu DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dailyMenuId, productId])
  @@index([dailyMenuId])
  @@index([productId])
}

// ------------------------------- CUSTOMER ----------------------------------

model Customer {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  name         String?
  phone        String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId])
}

// -------------------------------- ORDER ------------------------------------

model Order {
  id            Int         @id @default(autoincrement())
  restaurantId  Int
  tableId       Int?
  customerId    Int?
  serverId      Int?
  orderNumber   String      @unique
  trackingToken String      @unique
  type          OrderType   @default(DINE_IN)
  pickupCode    String?
  status        OrderStatus @default(NEW)
  customerName  String?
  customerPhone String?
  comment       String?     @db.Text
  subtotal      Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  currency      String      @default("FCFA")
  // Temps d'attente annonce au client. C'est la serveuse qui le decide : elle
  // voit la cuisine, une moyenne calculee ne la voit pas. On garde les deux :
  // la duree annoncee (pour l'afficher telle qu'elle a ete dite) et l'heure
  // d'arrivee prevue (pour qu'un compte a rebours reste juste apres un
  // rechargement de page).
  estimatedMinutes Int?
  estimatedReadyAt DateTime?
  acceptedAt    DateTime?
  preparingAt   DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Restrict explicite : tableId est devenu optionnel pour la vente a emporter,
  // mais supprimer une table qui a servi doit rester impossible. Sans cela
  // Prisma basculerait sur SET NULL et ces commandes passees se confondraient
  // avec des commandes a emporter.
  table         RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  server        User?                @relation("OrderServer", fields: [serverId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  subscriptionUsages SubscriptionUsage[]
  review              Review?
  loyaltyTransactions LoyaltyTransaction[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([serverId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int?
  productName  String
  unitPrice    Decimal @db.Decimal(12, 2)
  optionsTotal Decimal @default(0) @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)
  note         String? @db.Text

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  options OrderItemOption[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemOption {
  id            Int     @id @default(autoincrement())
  orderItemId   Int
  optionValueId Int?
  optionName    String
  valueName     String
  priceDelta    Decimal @default(0) @db.Decimal(12, 2)

  orderItem   OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  userId    Int?
  comment   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// --------------------------- SERVICE REQUEST -------------------------------

model ServiceRequest {
  id           Int                  @id @default(autoincrement())
  restaurantId Int
  tableId      Int
  handledById  Int?
  type         ServiceRequestType
  status       ServiceRequestStatus @default(PENDING)
  message      String?              @db.Text
  handledAt    DateTime?
  // Rappels du client quand personne n'est venu. On garde le compte ET la date
  // du dernier : le compte sert a l'affichage, la date a espacer les rappels.
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handledBy  User?           @relation("ServiceRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
}

// ----------------------------- NOTIFICATION --------------------------------

model Notification {
  id           Int              @id @default(autoincrement())
  restaurantId Int
  userId       Int?
  type         NotificationType
  title        String
  body         String?          @db.Text
  data         String?          @db.Text
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
}

// ----------------------------- ABONNEMENTS ---------------------------------

// Un abonne n'a NI compte NI mot de passe : sa preuve, c'est le ticket papier
// et le QR Code imprime dessus. Tout est cree et gere par l'administration.
model Subscription {
  id           Int                @id @default(autoincrement())
  restaurantId Int
  number       String             @unique
  // Jeton encode dans le QR Code du ticket. Non devinable, distinct de l'id.
  verifyToken  String             @unique
  firstName    String
  lastName     String
  phone        String
  plan         SubscriptionPlan
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime
  amount       Decimal?           @db.Decimal(12, 2)
  note         String?            @db.Text
  renewalCount Int                @default(0)
  renewedAt    DateTime?
  createdById  Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("SubscriptionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  usages     SubscriptionUsage[]

  @@index([restaurantId])
  @@index([phone])
  @@index([endDate])
  @@index([status])
}

// Une ligne par passage. Consulter un ticket n'ecrit rien ici : seul un membre
// du personnel qui valide l'utilisation cree une ligne, sinon un client qui
// verifie sa propre carte consommerait un passage.
model SubscriptionUsage {
  id             Int                   @id @default(autoincrement())
  restaurantId   Int
  subscriptionId Int
  orderId        Int?
  userId         Int?
  type           SubscriptionUsageType @default(REPAS)
  note           String?               @db.Text
  createdAt      DateTime              @default(now())

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user         User?        @relation("SubscriptionUsageAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([subscriptionId])
  @@index([createdAt])
}

// ------------------------------- FIDELITE -----------------------------------

// Un compte par (restaurant, telephone). Comme les abonnements, aucun mot de
// passe : le client n'a que son numero, tape a la commande, comme preuve.
model LoyaltyAccount {
  id               Int      @id @default(autoincrement())
  restaurantId     Int
  phone            String
  name             String?
  points           Int      @default(0)
  rewardsAvailable Int      @default(0)
  rewardsRedeemed  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

// Une ligne par mouvement : gain a une commande servie, recompense debloquee,
// recompense utilisee en salle, ajustement manuel. Meme logique que
// SubscriptionUsage/AuditLog : l'historique doit rester lisible meme apres
// coup, pas seulement le solde courant.
model LoyaltyTransaction {
  id               Int                    @id @default(autoincrement())
  restaurantId     Int
  loyaltyAccountId Int
  orderId          Int?
  userId           Int?
  type             LoyaltyTransactionType
  points           Int
  note             String?                @db.Text
  createdAt        DateTime               @default(now())

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user           User?          @relation("LoyaltyTransactionAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([loyaltyAccountId])
}

// -------------------------------- AVIS --------------------------------------

// Un avis par commande (contrainte unique sur orderId) : uniquement possible
// une fois la commande SERVED, cote controller.
model Review {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  orderId      Int      @unique
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([rating])
}

// --------------------------- NOTIFICATIONS PUSH ------------------------------

// Un abonnement Web Push par navigateur/appareil ou le personnel a accepte les
// notifications. Un utilisateur peut en avoir plusieurs (telephone + poste
// fixe). Nettoye automatiquement si l'endpoint est revoque (404/410).
model PushSubscription {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  userId       Int
  endpoint     String   @unique @db.VarChar(500)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  userAgent    String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
}

// ------------------------------- JOURNAL -----------------------------------

// Trace des actions de gestion : qui a fait quoi, quand.
//
// Le nom de l'auteur est recopie ici. Sans cette copie, supprimer un compte
// effacerait du meme coup la trace de ce qu'il a fait - exactement ce que le
// journal doit empecher.
model AuditLog {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  userId       Int?
  userName     String
  userRole     Role
  action       String   @db.VarChar(60)
  entity       String   @db.VarChar(40)
  entityId     Int?
  label        String   @db.Text
  // Complement au format JSON : ancien et nouveau prix, par exemple.
  details      String?  @db.Text
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation("AuditAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([action])
  @@index([entity, entityId])
}

// ------------------------------ SAUVEGARDES --------------------------------

// Instantane complet des donnees, pris automatiquement chaque nuit.
//
// Le contenu vit dans la base elle-meme : cela protege de l'erreur humaine
// (une suppression de trop), ce qui est le risque courant. Cela ne protege pas
// de la perte de la base entiere - d'ou le telechargement, qui reste le seul
// moyen d'avoir une copie ailleurs.
model BackupSnapshot {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  // AUTOMATIQUE (planificateur) ou MANUEL (bouton de l'administration).
  trigger      String   @db.VarChar(20)
  sizeBytes    Int
  // Nombre de lignes par table, pour lire le contenu sans le telecharger.
  counts       String?  @db.Text
  content      String?  @db.LongText
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

// -------------------------------- CLOTURES ---------------------------------

// Ce qu'a donne une journee, fige une fois pour toutes.
//
// Tout est recalculable depuis les commandes ; on fige quand meme, parce que
// c'est ce qui permet de comparer deux jours sans rejouer des agregations, et
// parce qu'une cloture doit dire ce qu'on a lu ce soir-la.
model DailyClosing {
  id             Int      @id @default(autoincrement())
  restaurantId   Int
  date           DateTime @db.Date
  revenue        Decimal  @db.Decimal(12, 2)
  ordersCount    Int
  cancelledCount Int
  averageTicket  Decimal  @db.Decimal(12, 2)
  dineInRevenue  Decimal  @db.Decimal(12, 2)
  takeawayRevenue Decimal @db.Decimal(12, 2)
  // [{ name, quantity, revenue }], les plats les plus vendus du jour.
  topProducts    String?  @db.Text
  // [{ id, name, orders, revenue }], une ligne par serveuse.
  servers        String?  @db.Text
  peakHour       Int?
  subscriptionUsages Int  @default(0)
  serviceRequests    Int  @default(0)
  closedAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId, date])
}
